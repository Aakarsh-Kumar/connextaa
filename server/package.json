{
  "name": "connectify-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "dev": "nodemon --watch src/**/*.ts --exec ts-node src/server.ts",
    "lint": "eslint 'src/**/*.ts'",
    "db:push": "prisma db push --config src/prisma.config.ts",
    "db:generate": "prisma generate --config src/prisma.config.ts",
    "db:sync": "npm run db:push && npm run db:generate",
    "gen:postman": "openapi2postmanv2 -s docs/v1_openapi.yaml -o docs/Connectify_V1_Postman_Collection.json",
    "gen:types": "npx openapi-typescript docs/v1_openapi.yaml -o src/types/api.ts",
    "gen:zod": "npx openapi-zod-client docs/v1_openapi.yaml -o src/utils/zod.ts",
    "gen": "npm run gen:postman && npm run gen:types && npm run gen:zod"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.0.1",
    "@types/winston-loggly-bulk": "^3.0.6",
    "eslint": "^9.29.0",
    "express": "^5.1.0",
    "install": "^0.13.0",
    "nodemon": "^3.1.10",
    "npm": "^11.4.2",
    "openapi-to-postmanv2": "^6.1.0",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/mongodb": "^4.0.6",
    "@types/uuid": "^10.0.0",
    "@zodios/core": "^10.9.6",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.19.0",
    "mqtt": "^5.14.1",
    "ms": "^2.1.3",
    "pg": "^8.16.3",
    "prisma": "^7.8.0",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "winston-loggly-bulk": "^3.3.2",
    "zod": "^3.25.76",
    "dotenv": "^16.5.0"
  }
